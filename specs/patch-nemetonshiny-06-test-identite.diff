+  # nom d'une colonne de score de famille signalerait le retour de la copie.
+  keys <- names(nemetonshiny:::TRANSLATIONS)
+  famille_cols <- nemeton::indicator_families()$family_column
+
+  expect_equal(intersect(famille_cols, keys), character(0))
