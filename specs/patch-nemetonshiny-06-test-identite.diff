+#
+# La table n'est plus declaree ici : elle est reconstruite depuis
+# `nemeton::indicator_families()` par `.build_indicator_families()`. Les tests
+# de structure (12 familles, codes, champs requis, longueurs, couleurs hex)
+# vivent desormais cote coeur, qui en est proprietaire - les repeter ici ne
+# testerait que la copie.
+#
+# Ce qui reste a tester ici, et qui manquait : que l'app ne REDECLARE rien.
+# C'est ce trou qui avait laisse passer, en silence, un fork a 40 indicateurs
+# au lieu de 41 (A5 absent) avec 14 libelles et 18 tooltips divergents.
+
+test_that("la table des familles vient du coeur, sans redeclaration", {
+  ref <- nemeton::indicator_families()
+  fams <- nemetonshiny:::INDICATOR_FAMILIES
+
+  expect_false(is.null(fams), info = "INDICATOR_FAMILIES non rempli : .onLoad() n'a pas tourne ?")
+  expect_identical(names(fams), ref$code)
+
+  for (i in seq_len(nrow(ref))) {
+    code <- ref$code[i]
+    f <- fams[[code]]
+
+    expect_identical(f$code, code)
+    expect_identical(f$name_fr, ref$name_fr[i], info = code)
+    expect_identical(f$name_en, ref$name_en[i], info = code)
+    expect_identical(f$icon, ref$icon[i], info = code)
+    expect_identical(f$color, ref$color[i], info = code)
+    expect_identical(f$indicators, ref$indicators[[i]], info = code)
+    expect_identical(f$column_names, ref$column_names[[i]], info = code)
+
+    expect_identical(
+      vapply(f$indicator_labels, `[[`, character(1), "fr"),
+      ref$labels_fr[[i]],
+      info = code
     )
-  }
-})
