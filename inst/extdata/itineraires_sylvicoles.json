        "B": {
          "sens": "+",
          "horizon": "long",
          "source": "ONF 2013, avant-propos (p. 3) : maintien voire amélioration du mélange d'essences ; p. 8 : arbres « bio » conservés"
        },
        "R": {
          "sens": "+",
          "horizon": "long",
          "source": "ONF 2013, avant-propos (p. 3) : le mélange d'essences objectif associées favorise la résilience en cas de perturbation"
