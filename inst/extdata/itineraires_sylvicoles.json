      "effets_attendus": {
        "P": {
          "sens": "+",
          "horizon": "long",
          "source": "ONF 2013, p. 21 et 23 : récolte proche de l'accroissement courant en G ; avant-propos (p. 3) : production de bois d'œuvre"
