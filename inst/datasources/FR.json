{
  "country": "FR",
  "country_name": {
    "fr": "France",
    "en": "France",
    "de": "Frankreich"
  },
  "crs_national": 2154,
  "crs_name": "RGF93 / Lambert-93",

  "services": {
    "ign_wfs": {
      "url": "https://data.geopf.fr/wfs/ows",
      "version": "2.0.0",
      "provider": "IGN Géoplateforme"
    },
    "ign_wms": {
      "url": "https://data.geopf.fr/wms-r/wms",
      "version": "1.3.0",
      "provider": "IGN Géoplateforme"
    },
    "cadastre_api": {
      "url": "https://cadastre.data.gouv.fr/bundler/cadastre-etalab/communes/{code_commune}/geojson/parcelles",
      "provider": "Etalab"
    },
    "communes_api": {
      "url": "https://geo.api.gouv.fr",
      "provider": "Etalab"
    }
  },

  "layers": {
    "dem": {
      "service": "ign_wms",
      "layer": "ELEVATION.ELEVATIONGRIDCOVERAGE",
      "description": "Modèle Numérique de Terrain (MNT)",
      "resolution_m": 5
    },
    "ortho_irc": {
      "service": "ign_wms",
      "layer": "ORTHOIMAGERY.ORTHOPHOTOS.IRC",
      "description": "Orthophotographie Infrarouge Couleur",
      "resolution_m": 0.2
    },
    "bdforet": {
      "service": "ign_wfs",
      "typename": "LANDCOVER.FORESTINVENTORY.V2:formation_vegetale",
      "description": "BD Forêt V2 - Formations végétales"
    },
    "roads": {
      "service": "ign_wfs",
      "typename": "BDTOPO_V3:troncon_de_route",
      "description": "BD TOPO - Réseau routier"
    },
    "water_network": {
      "service": "ign_wfs",
      "typename": "BDTOPO_V3:troncon_hydrographique",
      "description": "BD TOPO - Réseau hydrographique"
    },
    "water_surfaces": {
      "service": "ign_wfs",
      "typename": "BDTOPO_V3:surface_hydrographique",
      "description": "BD TOPO - Surfaces hydrographiques"
    },
    "buildings": {
      "service": "ign_wfs",
      "typename": "BDTOPO_V3:batiment",
      "description": "BD TOPO - Bâtiments"
    },
    "departments": {
      "service": "ign_wfs",
      "typename": "ADMINEXPRESS-COG-CARTO.LATEST:departement",
      "description": "Limites départementales"
    },
    "protected_areas": {
      "provider": "happign",
      "source": "inpn_wfs",
      "description": "Inventaire National du Patrimoine Naturel"
    },
    "lidar_mnh": {
      "provider": "happign",
      "product": "mnh",
      "happign_layer": "IGNF_MNH-LIDAR-HD:dalle",
      "description": "LiDAR HD - Modèle Numérique de Hauteur",
      "resolution_m": 1
    },
    "lidar_mnt": {
      "provider": "happign",
      "product": "mnt",
      "happign_layer": "IGNF_MNT-LIDAR-HD:dalle",
      "description": "LiDAR HD - Modèle Numérique de Terrain",
      "resolution_m": 1
    },
    "lidar_mns": {
      "provider": "happign",
      "product": "mns",
      "happign_layer": "IGNF_MNS-LIDAR-HD:dalle",
      "description": "LiDAR HD - Modèle Numérique de Surface",
      "resolution_m": 1
    },
    "lidar_copc": {
      "provider": "happign",
      "product": "nuage",
      "happign_layer": "IGNF_NUAGES-DE-POINTS-LIDAR-HD:dalle",
      "description": "LiDAR HD - Nuages de points COPC"
    }
  },

  "datasets": {
    "soilgrids_cec": {
      "type": "raster_remote",
      "url": "https://files.isric.org/soilgrids/latest/data/cec/cec_0-5cm_mean.vrt",
      "description": "SoilGrids 2.0 — Cation Exchange Capacity, 0-5 cm topsoil, mean. Direct proxy for nutrient availability and forest soil fertility.",
      "resolution_m": 250,
      "unit": "cmol(c)/kg × 10",
      "native_crs": "Homolosine (IGH)",
      "format": "VRT (tiled COG)",
      "provider": "ISRIC - World Soil Information",
      "license": "CC-BY-4.0",
      "citation": "Poggio et al. (2021) SoilGrids 2.0: producing soil information for the globe with quantified spatial uncertainty. SOIL 7:217-240."
    },
    "field_qfield": {
      "type": "vector_local",
      "format": "GeoPackage",
      "description": "Field inventory collected on QField (placettes + arbres layers), produced by create_qfield_project() and re-ingested via import_qfield_gpkg().",
      "required_crs": "EPSG:2154",
      "layers": ["placettes", "arbres"],
      "ndp_bump": {
        "plots_only": 2,
        "with_trees_min10_per_plot": 3
      },
      "license": "User-generated content - copyright held by the field operator.",
      "note": "Tag an sf with tag_field_data_sources() so detect_ndp() picks up the NDP bump."
    },
    "chm_opencanopy": {
      "type": "raster_local",
      "format": "COG",
      "description": "Canopy Height Model from opencanopy (IGN BD ORTHO + Open-Canopy pretrained models)",
      "required_crs": "EPSG:2154",
      "fallback_crs": "EPSG:3035",
      "resolution_m": [0.20, 1.5],
      "unit": "m",
      "value_range": [0, 50],
      "provenance": {
        "package": "opencanopy",
        "repo": "https://github.com/pobsteta/opencanopynemeton",
        "version_min": "0.1.0",
        "model": ["unet", "pvtv2"],
        "base_data": "BD ORTHO IGN + Open-Canopy pretrained weights (Fogel et al. 2024)"
      },
      "license": {
        "bd_ortho": "Licence Ouverte / Etalab 2.0",
        "open_canopy": "MIT (code) / CC-BY-4.0 (data) — to confirm at commit",
        "derived": "CHM = double attribution IGN BD ORTHO + Fogel et al. 2024"
      }
    },
    "forms_t": {
      "type": "raster_local",
      "format": "COG",
      "description": "FORMS-T — Forest Multiple-Source height, wood volume and biomass time-series over metropolitan France (2018-present). Deep-learning fusion of Sentinel-1, Sentinel-2 and GEDI spaceborne lidar. Three products: canopy height (10 m), standing wood volume (30 m), aboveground biomass (30 m).",
      "native_crs": "EPSG:2154",
      "required_crs": "EPSG:2154",
      "fallback_crs": "EPSG:3035",
      "temporal_coverage": "2018-present (annual)",
      "ndp_level": 0,
      "augmented": "height_ml",
      "access": {
        "doi": "https://doi.theia.data-terra.org/FormsT/",
        "stac_catalog": "https://browser-theia.stac.teledetection.fr/",
        "zenodo": "https://zenodo.org/records/15489231",
        "note": "Distributed by DATA TERRA / THEIA (CDS-MTD diffusion service). COG assets are resolved per-tile and per-year from the STAC catalog, or downloaded as .tif from the Zenodo record. There is no single static URL, so load_raster_source() cannot fetch this source directly: the caller must resolve the STAC asset href (or a local download path) first."
      },
      "products": {
        "height": {
          "variable": "canopy_height",
          "resolution_m": 10,
          "unit": "cm",
          "value_range": [0, 6000],
          "note": "FORMS-T height is stored in centimetres (10^-2 m). The nemeton indicator `chm` argument expects metres: divide the raster by 100 before passing it to indicateur_p1_volume(), indicateur_p2_station(), indicateur_c1_biomasse() or indicateur_b2_structure()."
        },
        "volume": {
          "variable": "growing_stock_volume",
          "resolution_m": 30,
          "unit": "m3/ha",
          "value_range": [0, 1500]
        },
        "biomass": {
          "variable": "aboveground_biomass",
          "resolution_m": 30,
          "unit": "Mg/ha",
          "value_range": [0, 800]
        }
      },
      "consumed_by": {
        "C1": "indicateur_c1_biomasse(chm = forms_t_height / 100) — canopy height feeds the CHM biomass path V(D, H) x rho x BEF x C_frac.",
        "P1": "indicateur_p1_volume(chm = forms_t_height / 100) — dominant height for the IFN volume tarif.",
        "P2": "indicateur_p2_station(chm = forms_t_height / 100) — H_dom for the Duplat & Tran-Ha site index.",
        "B2": "indicateur_b2_structure(chm = forms_t_height / 100) — CV(CHM) structural component."
      },
      "provenance": {
        "producer": "Schwartz et al. (LSCE / Kayrros)",
        "method": "Deep-learning multi-stream model fusing Sentinel-1, Sentinel-2 and GEDI lidar; biomass and volume via allometric equations fitted on French NFI plots.",
        "reference": "Schwartz et al. (2023) FORMS: Forest Multiple Source height, wood volume, and biomass maps in France at 10 to 30 m resolution. Earth Syst. Sci. Data 15:4927-4945. doi:10.5194/essd-15-4927-2023"
      },
      "license": "CC-BY-4.0 (to confirm at the Zenodo record before redistribution)"
    },
    "oso": {
      "url": "https://entrepot.recherche.data.gouv.fr/api/access/datafile/:persistentId?persistentId=doi:10.57745/8M1AN1",
      "description": "OSO - Occupation du Sol (Theia/CESBIO)",
      "resolution_m": 10,
      "forest_classes": {
        "17": "deciduous",
        "18": "coniferous",
        "19": "mixed"
      }
    },
    "hunting": {
      "provider": "OFB / data.gouv.fr",
      "description": "Tableaux de chasse départementaux du grand gibier",
      "dataset_slug": "evolution-des-tableaux-de-chasse-departementaux-du-grand-gibier-en-france-donnees-depuis-1973",
      "api_url": "https://www.data.gouv.fr/api/1/datasets/evolution-des-tableaux-de-chasse-departementaux-du-grand-gibier-en-france-donnees-depuis-1973/",
      "note": "URLs are resolved dynamically at runtime via the data.gouv.fr API (see R/data-hunting.R::resolve_hunting_urls_from_api). The static URLs in 'species' are a fallback only and may become outdated when files are re-uploaded on data.gouv.fr.",
      "species_files": {
        "chevreuil": "chevreuil-departement.csv",
        "cerf": "cerf-elaphe-departement.csv",
        "sanglier": "sanglier-departement.csv",
        "chamois": "chamois-departement.csv",
        "isard": "isard-departement.csv",
        "mouflon": "mouflon-departement.csv",
        "daim": "daim-departement.csv",
        "cerf_sika": "cerf-sika-departement.csv"
      },
      "species": {
        "chevreuil": "https://static.data.gouv.fr/resources/evolution-des-tableaux-de-chasse-departementaux-du-grand-gibier-en-france-donnees-depuis-1973/20250605-140029/chevreuil-departement.csv",
        "cerf": "https://static.data.gouv.fr/resources/evolution-des-tableaux-de-chasse-departementaux-du-grand-gibier-en-france-donnees-depuis-1973/20250605-140037/cerf-elaphe-departement.csv",
        "sanglier": "https://static.data.gouv.fr/resources/evolution-des-tableaux-de-chasse-departementaux-du-grand-gibier-en-france-donnees-depuis-1973/20250605-140017/sanglier-departement.csv",
        "chamois": "https://static.data.gouv.fr/resources/evolution-des-tableaux-de-chasse-departementaux-du-grand-gibier-en-france-donnees-depuis-1973/20250605-140032/chamois-departement.csv",
        "isard": "https://static.data.gouv.fr/resources/evolution-des-tableaux-de-chasse-departementaux-du-grand-gibier-en-france-donnees-depuis-1973/20250605-140024/isard-departement.csv",
        "mouflon": "https://static.data.gouv.fr/resources/evolution-des-tableaux-de-chasse-departementaux-du-grand-gibier-en-france-donnees-depuis-1973/20250605-140020/mouflon-departement.csv",
        "daim": "https://static.data.gouv.fr/resources/evolution-des-tableaux-de-chasse-departementaux-du-grand-gibier-en-france-donnees-depuis-1973/20250605-140026/daim-departement.csv",
        "cerf_sika": "https://static.data.gouv.fr/resources/evolution-des-tableaux-de-chasse-departementaux-du-grand-gibier-en-france-donnees-depuis-1973/20250605-140034/cerf-sika-departement.csv"
      }
    }
  },

  "communes": {
    "search_url": "https://geo.api.gouv.fr/communes",
    "geometry_url": "https://geo.api.gouv.fr/communes/{code_commune}",
    "department_url": "https://geo.api.gouv.fr/departements/{code_departement}/communes"
  }
}
