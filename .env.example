# Copie ce fichier en .env et remplis les valeurs avant `docker compose up`.
# .env est ignoré par git (voir .gitignore).

# --- TimescaleDB (spec 007 — E6 monitoring) ---
POSTGRES_USER=nemeton
POSTGRES_DB=nemeton
POSTGRES_PASSWORD=change_me_to_a_strong_secret

# URL consommée par nemeton::db_connect() côté R
NEMETON_DB_URL=postgresql://nemeton:change_me_to_a_strong_secret@127.0.0.1:5432/nemeton
